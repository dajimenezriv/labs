    {
      "type": "row",
      "id": 26,
      "title": "Vacuum & locks",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 27,
      "title": "Dead tuples",
      "description": "Dead \u00f7 (live + dead) rows per table. `UPDATE` and `DELETE` leave the old row version behind; autovacuum makes the space reusable. By default autovacuum starts at 20% dead (`autovacuum_vacuum_scale_factor`).\n\nLook for: a table climbing well past 20% and staying there. Autovacuum is blocked by a long transaction (see *Oldest open transaction*) or can't keep up with the write rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (relname) (pg_stat_user_tables_n_dead_tup{instance=~\"$instance\", datname=~\"$datname\"}) / (sum by (relname) (pg_stat_user_tables_n_live_tup{instance=~\"$instance\", datname=~\"$datname\"}) + sum by (relname) (pg_stat_user_tables_n_dead_tup{instance=~\"$instance\", datname=~\"$datname\"})))",
          "legendFormat": "{{relname}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 61,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "table",
      "id": 28,
      "title": "Time since last autovacuum",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Per table, now. Tables never autovacuumed aren't listed: small or insert-only tables can legitimately go a long time.\n\nLook for: a table that gets constant writes and hasn't been vacuumed in hours.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Since last autovacuum",
            "desc": true
          }
        ],
        "cellHeight": "sm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max by (relname) (pg_stat_user_tables_last_autovacuum{instance=~\"$instance\", datname=~\"$datname\"} > 0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Since last autovacuum"
            }
          }
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 61,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "id": 29,
      "title": "Locks held or awaited by mode",
      "description": "Rows in `pg_locks` at scrape time, by mode. `AccessShareLock` is every `SELECT` and is normal.\n\nLook for: `AccessExclusiveLock` during traffic. It's taken by `ALTER TABLE`, `DROP` and `TRUNCATE`, and blocks even reads, so every query on that table queues behind the migration. Set `lock_timeout` in migrations.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (mode) (pg_locks_count{instance=~\"$instance\", datname=~\"$datname\"})",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 61,
        "w": 8,
        "h": 8
      }
    }
  ]
}